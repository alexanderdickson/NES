{
  "name": "nes",
  "version": "0.0.0",
  "description": "A NES emulator written in TypeScript utilising modern web technologies and with debugging tools",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@typescript/native-preview": "^7.0.0-dev.20260629.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0"
  },
  "packageManager": "pnpm@10.33.3"
}
